// Единый набор правил для общего Firebase-проекта `natas-kitchen`, в котором
// рядом живут ДВА независимых приложения:
//   • «Моя кухня» — семьи, рецепты, фото, публичные ссылки, справочник КБЖУ;
//     корневые коллекции users/, households/, recipes/, recipeImages/,
//     shares/, nutrition/.
//   • Twin (менеджер задач) — целиком в своём пространстве
//     apps/twin/users/{uid}/...
// Пути приложений не пересекаются, поэтому правила просто соседствуют.
// Catch-all deny не нужен: всё, что не описано ниже, Firestore запрещает сам.
//
// ВАЖНО: это ОДИН документ на весь проект. Консоль Firestore хранит только
// последнюю опубликованную версию, поэтому деплоить нужно ВЕСЬ этот файл —
// если вставить правила только одного приложения, второе тут же отключится
// (именно так и вышло: правила «Кухни» без блока apps/twin положили Twin).
// Копия этого файла лежит в обоих репозиториях и должна оставаться
// одинаковой: natalyatsarapaeva-tech/Nata-s_kitchen и .../twin.
//
// Перед первым деплоем (шаги владельца):
//   1. Firebase Console → Authentication → включить провайдеры
//      Google и Email/Password.
//   2. Authentication → Settings → Authorized domains → добавить
//      natalyatsarapaeva-tech.github.io
//   3. Вставить эти правила: Console → Firestore Database → Rules
//      (или firebase deploy --only firestore:rules).
//
// Модель «Кухни»:
//   users/{uid}        — маппинг пользователь → семья (пишет только сам)
//   households/{hid}   — профиль семьи; подколлекции recipeState/plans/prices — только членам
//   recipes/{id}       — общая книга: читают все вошедшие, правит автор
//   recipeImages/{id}  — большое фото блюда: читают вошедшие, пишет тот, кто
//                        вправе править сам рецепт
//   shares/{token}     — снимок ОДНОГО рецепта для публичной ссылки: читает
//                        кто угодно по точному токену (без входа), пишет и
//                        отзывает только тот, кто поделился
//   nutrition/{id}     — общий справочник КБЖУ (факты, не мнения)
//
// Модель Twin:
//   apps/twin/users/{uid}/{tasks|contexts|meta}/... — только сам пользователь

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Семья текущего пользователя из users/{uid}
    function myHousehold() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId;
    }

    // Может ли текущий пользователь править рецепт recipeId — те же условия,
    // что в match /recipes: автор либо член легаси-семьи для легаси-рецепта.
    // Порядок важен: myHousehold() читает users/{uid}, поэтому проверяется
    // вторым (для автора лишнего чтения не будет).
    function canEditRecipeDoc(recipeId) {
      return exists(/databases/$(database)/documents/recipes/$(recipeId))
        && (get(/databases/$(database)/documents/recipes/$(recipeId)).data.get('createdBy', 'default') == request.auth.uid
            || (get(/databases/$(database)/documents/recipes/$(recipeId)).data.get('createdBy', 'default') == 'default'
                && myHousehold() == 'default'));
    }

    // ═══════════ «Моя кухня» (семьи, рецепты, фото, ссылки, КБЖУ) ═══════════

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /households/{hid} {
      // читать нужно всем вошедшим: поиск семьи по joinCode при онбординге
      allow read: if signedIn();
      // создание новой семьи — любой вошедший; владелец записывается в ownerUid
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      // править может член семьи; незанятую легаси-семью (без ownerUid)
      // может забрать первый вошедший (claim владельца)
      allow update: if signedIn()
        && (myHousehold() == hid || !('ownerUid' in resource.data));

      match /{sub=**} {
        allow read, write: if signedIn() && myHousehold() == hid;
      }
    }

    match /recipes/{recipeId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      // правит автор; легаси-рецепты (createdBy 'default' или отсутствует) —
      // члены легаси-семьи 'default'
      allow update, delete: if signedIn()
        && (resource.data.createdBy == request.auth.uid
            || ((!('createdBy' in resource.data) || resource.data.createdBy == 'default')
                && myHousehold() == 'default'));
      // «Переселить в другую семью»: член ТЕКУЩЕЙ семьи рецепта может сменить
      // ТОЛЬКО householdId (даже не будучи автором) — чтобы вытащить рецепт,
      // осевший не в ту семью. Меняется одно поле, автор/содержимое неизменны.
      // ВАЖНО: у старых рецептов поля householdId может НЕ быть; обращение к
      // отсутствующему полю в правилах — ошибка (deny), поэтому только get() с
      // дефолтом 'default' (отсутствие/старый формат = легаси-семья).
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['householdId'])
        && resource.data.get('householdId', 'default') == myHousehold();
    }

    // Фото блюда лежит отдельным документом (в самом рецепте — только
    // маленький квадрат-аватар): список рецептов не должен тащить мегабайты.
    // Право на запись — то же, что на правку рецепта, поэтому смотрим в него.
    match /recipeImages/{recipeId} {
      allow read: if signedIn();
      allow write: if signedIn() && canEditRecipeDoc(recipeId);
    }

    // Публичная ссылка на один рецепт.
    // get разрешён всем: по ссылке открывается ровно этот документ и ничего
    // больше — токен неугадываемый, а список коллекции наружу не отдаётся
    // (list — только свои ссылки). Отозвать ссылку может только автор снимка.
    match /shares/{token} {
      allow get: if true;
      allow list: if signedIn() && resource.data.createdBy == request.auth.uid;
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /nutrition/{ingredientId} {
      allow read, write: if signedIn();
    }

    // ═══════════ Twin (менеджер задач, в своём пространстве) ═══════════
    // Каждый вошедший пользователь читает и пишет ТОЛЬКО своё поддерево.
    // Модель данных: apps/twin/users/{uid}/{tasks|contexts|meta}/...

    match /apps/twin/users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
